{
  "name": "tribe",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable Tribe coordination + memory infrastructure: wire client, daemon, recall engine, and host plugins",
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beorn/tribe.git"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "tsc --noEmit",
    "recall": "bun packages/recall/src/cli.ts",
    "test": "bunx --bun vitest run",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "oxfmt": "0.38.0",
    "removely": "^0.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=23.6.0"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ]
}

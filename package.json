{
  "name": "tribe",
  "private": true,
  "version": "0.0.0",
  "description": "Reusable Tribe coordination infrastructure: wire client, daemon, and host plugins",
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beorn/tribe.git"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "tsc --noEmit",
    "test": "bunx --bun vitest run"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=23.6.0"
  }
}

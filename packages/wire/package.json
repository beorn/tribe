{
  "name": "tribe-wire",
  "version": "0.3.0",
  "description": "Tribe wire client — Unix-socket IPC, JSON-RPC protocol, reconnecting client, MCP stdio adapter, and the `tribe-wire` protocol CLI",
  "keywords": [
    "claude-code",
    "cli",
    "client",
    "ipc",
    "json-rpc",
    "mcp",
    "stdio-adapter",
    "tribe",
    "unix-socket"
  ],
  "homepage": "https://github.com/beorn/tribe/tree/main/packages/wire",
  "bugs": {
    "url": "git+https://github.com/beorn/tribe/issues"
  },
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beorn/tribe.git",
    "directory": "packages/wire"
  },
  "bin": {
    "tribe-wire": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./launch-environment": "./src/launch-environment.ts",
    "./client": "./src/barrels/client.ts",
    "./trust": "./src/trust.ts",
    "./records": "./src/barrels/records.ts",
    "./service-send": "./src/service-send.ts",
    "./cli": "./src/cli.ts",
    "./stdio": "./src/stdio-adapter.ts",
    "./lib/socket": "./src/lib/socket.ts",
    "./lib/config": "./src/lib/config.ts",
    "./lib/tools-list": "./src/lib/tools-list.ts",
    "./lib/cwd-guardrail": "./src/lib/cwd-guardrail.ts",
    "./lib/hot-reload": "./src/lib/hot-reload.ts",
    "./lib/transcript": "./src/lib/transcript.ts",
    "./lib/defang": "./src/lib/defang.ts",
    "./lib/persona-name": "./src/lib/persona-name.ts",
    "./lib/persona-launch-identity": "./src/lib/persona-launch-identity.ts",
    "./lib/spawn-pin-gate": "./src/lib/spawn-pin-gate.ts",
    "./lib/code-identity": "./src/lib/code-identity.ts",
    "./lib/reload-pacing": "./src/lib/reload-pacing.ts",
    "./lib/identity-token": "./src/lib/identity-token.ts",
    "./lib/hab-session-env": "./src/lib/hab-session-env.ts",
    "./lib/session-identity-env": "./src/lib/session-identity-env.ts",
    "./lib/ag-host-env": "./src/lib/ag-host-env.ts",
    "./lib/daemon-environment": "./src/lib/daemon-environment.ts",
    "./http": "./src/http-adapter.ts"
  },
  "publishConfig": {
    "bin": {
      "tribe-wire": "./dist/cli.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./launch-environment": {
        "types": "./dist/launch-environment.d.mts",
        "import": "./dist/launch-environment.mjs"
      },
      "./client": {
        "types": "./dist/barrels/client.d.mts",
        "import": "./dist/barrels/client.mjs"
      },
      "./trust": {
        "types": "./dist/trust.d.mts",
        "import": "./dist/trust.mjs"
      },
      "./records": {
        "types": "./dist/barrels/records.d.mts",
        "import": "./dist/barrels/records.mjs"
      },
      "./service-send": {
        "types": "./dist/service-send.d.mts",
        "import": "./dist/service-send.mjs"
      },
      "./cli": {
        "types": "./dist/cli.d.mts",
        "import": "./dist/cli.mjs"
      },
      "./stdio": {
        "types": "./dist/stdio-adapter.d.mts",
        "import": "./dist/stdio-adapter.mjs"
      },
      "./lib/socket": {
        "types": "./dist/lib/socket.d.mts",
        "import": "./dist/lib/socket.mjs"
      },
      "./lib/config": {
        "types": "./dist/lib/config.d.mts",
        "import": "./dist/lib/config.mjs"
      },
      "./lib/tools-list": {
        "types": "./dist/lib/tools-list.d.mts",
        "import": "./dist/lib/tools-list.mjs"
      },
      "./lib/cwd-guardrail": {
        "types": "./dist/lib/cwd-guardrail.d.mts",
        "import": "./dist/lib/cwd-guardrail.mjs"
      },
      "./lib/hot-reload": {
        "types": "./dist/lib/hot-reload.d.mts",
        "import": "./dist/lib/hot-reload.mjs"
      },
      "./lib/transcript": {
        "types": "./dist/lib/transcript.d.mts",
        "import": "./dist/lib/transcript.mjs"
      },
      "./lib/defang": {
        "types": "./dist/lib/defang.d.mts",
        "import": "./dist/lib/defang.mjs"
      },
      "./lib/persona-name": {
        "types": "./dist/lib/persona-name.d.mts",
        "import": "./dist/lib/persona-name.mjs"
      },
      "./lib/persona-launch-identity": {
        "types": "./dist/lib/persona-launch-identity.d.mts",
        "import": "./dist/lib/persona-launch-identity.mjs"
      },
      "./lib/spawn-pin-gate": {
        "types": "./dist/lib/spawn-pin-gate.d.mts",
        "import": "./dist/lib/spawn-pin-gate.mjs"
      },
      "./lib/code-identity": {
        "types": "./dist/lib/code-identity.d.mts",
        "import": "./dist/lib/code-identity.mjs"
      },
      "./lib/reload-pacing": {
        "types": "./dist/lib/reload-pacing.d.mts",
        "import": "./dist/lib/reload-pacing.mjs"
      },
      "./lib/identity-token": {
        "types": "./dist/lib/identity-token.d.mts",
        "import": "./dist/lib/identity-token.mjs"
      },
      "./lib/hab-session-env": {
        "types": "./dist/lib/hab-session-env.d.mts",
        "import": "./dist/lib/hab-session-env.mjs"
      },
      "./lib/session-identity-env": {
        "types": "./dist/lib/session-identity-env.d.mts",
        "import": "./dist/lib/session-identity-env.mjs"
      },
      "./lib/ag-host-env": {
        "types": "./dist/lib/ag-host-env.d.mts",
        "import": "./dist/lib/ag-host-env.mjs"
      },
      "./lib/daemon-environment": {
        "types": "./dist/lib/daemon-environment.d.mts",
        "import": "./dist/lib/daemon-environment.mjs"
      },
      "./http": {
        "types": "./dist/http-adapter.d.mts",
        "import": "./dist/http-adapter.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun scripts/assert-pnpm-publish.ts && bun run build",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@bearly/flock": "^0.1.0",
    "@bearly/pacing": "0.2.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@silvery/commander": "^0.24.0",
    "loggily": "^0.11.0",
    "removely": "^0.3.0"
  },
  "devDependencies": {
    "tsdown": "0.22.13",
    "typescript": "^5.9.3"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/launch-environment.ts",
      "src/barrels/client.ts",
      "src/trust.ts",
      "src/barrels/records.ts",
      "src/service-send.ts",
      "src/cli.ts",
      "src/stdio-adapter.ts",
      "src/lib/socket.ts",
      "src/lib/config.ts",
      "src/lib/tools-list.ts",
      "src/lib/cwd-guardrail.ts",
      "src/lib/hot-reload.ts",
      "src/lib/transcript.ts",
      "src/lib/defang.ts",
      "src/lib/persona-name.ts",
      "src/lib/persona-launch-identity.ts",
      "src/lib/spawn-pin-gate.ts",
      "src/lib/code-identity.ts",
      "src/lib/reload-pacing.ts",
      "src/lib/identity-token.ts",
      "src/lib/hab-session-env.ts",
      "src/lib/session-identity-env.ts",
      "src/lib/ag-host-env.ts",
      "src/lib/daemon-environment.ts",
      "src/http-adapter.ts"
    ],
    "format": "esm"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}

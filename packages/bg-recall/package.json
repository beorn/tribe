{
  "name": "tribe-bg-recall",
  "version": "0.1.0",
  "private": true,
  "description": "Background just-in-time recall — async daemon that watches active Claude Code sessions, runs entity-driven recall queries, and injects high-relevance hints via the tribe channel",
  "keywords": [
    "claude-code",
    "daemon",
    "observability",
    "recall",
    "tribe"
  ],
  "homepage": "https://github.com/beorn/tribe/tree/main/packages/bg-recall",
  "bugs": {
    "url": "https://github.com/beorn/tribe/issues"
  },
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beorn/tribe.git",
    "directory": "packages/bg-recall"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@silvery/commander": "^0.19.2",
    "loggily": "^0.10.2",
    "tribe-recall": "workspace:*",
    "tribe-wire": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "tsdown": "^0.22.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": "src/index.ts",
    "format": "esm"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
